# CarCraft Backend Environment Configuration (Template)
# Copy this file to .env for local development

# Security Notice: NEVER commit your real .env file or production secret keys to version control!
DJANGO_SECRET_KEY=replace-this-with-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local React frontend origins allowed to access the backend API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database Configuration (Defaults to sqlite3 for foundation; ready for MySQL)
DATABASE_ENGINE=sqlite
# DB_NAME=carcraft_db
# DB_USER=carcraft_user
# DB_PASSWORD=secure_password
# DB_HOST=localhost
# DB_PORT=3306
